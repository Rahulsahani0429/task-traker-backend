# Task Tracker Backend Configuration
# Environment Variables Example Template

# Port to listen on (Render automatically injects PORT)
PORT=5000

# MongoDB Connection String (Do not use localhost in production)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/taskflow?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/task-tracker

# Frontend Client URL to allow CORS access
# Example: https://taskflow-app.vercel.app
CLIENT_URL=http://localhost:3000

# Node Environment (development or production)
NODE_ENV=development
